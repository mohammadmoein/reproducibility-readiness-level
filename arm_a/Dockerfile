# Copied verbatim from https://github.com/tobihol/agentic-reproducibility (commit dde239c),
# pipeline/agentic_analysis/Dockerfile. MIT License, see THIRD_PARTY_NOTICES.md.
# Arm A and Arm B must run in the same environment or the contrast between them is
# confounded by the image. Do not edit this file to accommodate a paper: an unresolvable
# dependency is an `environment` fault, and that is the measurement.

FROM python:3.12-slim-bookworm

# System deps:
#   build-essential, zlib1g-dev — pyreadstat / numpy / general C builds
#   octave                       — needed via oct2py for old-format MATLAB
#                                  table objects (scipy.io can't decode them)
#   p7zip-full, unzip            — handle archives the agent encounters
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    zlib1g-dev \
    octave \
    p7zip-full \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Analysis stack (covers ~95% of Multi100 data formats out of the box).
# pymupdf4llm: read paper PDFs inside the sandbox.
# Format coverage:
#   .dta/.sav/.por/.sas7bdat/.xpt → pyreadstat
#   .csv/.tsv/.json/.txt          → pandas (stdlib)
#   .xlsx                         → pandas + openpyxl
#   .xls (Excel 97-2003)          → pandas + xlrd
#   .RData/.rds (R)               → pyreadr
#   .mat (MATLAB v5/v6)           → scipy.io
#   .mat (MATLAB v7.3, HDF5)      → h5py / mat73
#   .mat (MATLAB Table objects)   → oct2py (calls into Octave)
#   .parquet/.feather             → pandas + pyarrow
#   .h5/.hdf5                     → h5py
#   .duckdb                       → duckdb
#   .7z                           → py7zr (or `7z` CLI from p7zip-full)
RUN pip install --no-cache-dir \
    pandas==2.2.3 \
    numpy==2.2.3 \
    scipy==1.15.2 \
    statsmodels==0.14.4 \
    pyreadstat==1.2.8 \
    pyreadr==0.5.3 \
    openpyxl==3.1.5 \
    xlrd==2.0.2 \
    h5py==3.14.0 \
    mat73==0.65 \
    oct2py==5.7.2 \
    pyarrow==21.0.0 \
    duckdb==1.4.2 \
    py7zr==1.0.0 \
    pymupdf4llm==1.27.2.2

WORKDIR /workspace
