# Generated by `lakdb completions nushell`; do not edit by hand.
# Regenerate with: uv run lakdb completions nushell | save --force completions/lakdb.nu

module "lakdb native completions" {
    export def "nu-complete lakdb flag value" [context: string, flag: string] {
        let words = ($context | split row " " | where {|word| $word != "" })
        let matches = ($words | enumerate | where {|entry| $entry.item == $flag })
        if ($matches | is-empty) {
            null
        } else {
            let index = (($matches | last).index + 1)
            if $index < ($words | length) {
                $words | get $index | str trim --char '"'
            } else {
                null
            }
        }
    }

    export def "nu-complete lakdb values" [kind: string, context: string] {
        let database = (nu-complete lakdb flag value $context "--database")
        let experiment = (nu-complete lakdb flag value $context "--experiment")
        let year = (nu-complete lakdb flag value $context "--year")
        let paper_kind = (nu-complete lakdb flag value $context "--kind")
        mut global_args = []
        mut filters = []
        if $database != null { $global_args = ["--database" $database] }
        if $kind in [batches artifact-batches papers] and $experiment != null {
            $filters = ($filters | append ["--experiment" $experiment])
        }
        if $kind == papers and $year != null {
            $filters = ($filters | append ["--year" $year])
        }
        if $kind == papers and $paper_kind != null {
            $filters = ($filters | append ["--kind-filter" $paper_kind])
        }
        if (($context | str starts-with "uv run lakdb") and ((which uv | is-not-empty))) {
            try { ^uv run lakdb ...$global_args completion-candidates $kind ...$filters | from json } catch { [] }
        } else if ((which lakdb | is-not-empty)) {
            try { ^lakdb ...$global_args completion-candidates $kind ...$filters | from json } catch { [] }
        } else if ((which uv | is-not-empty)) {
            try { ^uv run lakdb ...$global_args completion-candidates $kind ...$filters | from json } catch { [] }
        } else {
            []
        }
    }

    export def "nu-complete lakdb experiments" [context: string] { nu-complete lakdb values experiments $context }
    export def "nu-complete lakdb ara-experiments" [context: string] { nu-complete lakdb values ara-experiments $context }
    export def "nu-complete lakdb batches" [context: string] { nu-complete lakdb values batches $context }
    export def "nu-complete lakdb papers" [context: string] { nu-complete lakdb values papers $context }
    export def "nu-complete lakdb kinds" [] {
        [
            { value: "long", description: "Long paper" }
            { value: "short", description: "Short paper" }
        ]
    }
    export def "nu-complete lakdb reasoning" [] {
        [none minimal low medium high xhigh]
    }
    export def "nu-complete lakdb years" [] {
        [2021 2022 2023 2024 2025 2026]
    }
    export def "nu-complete lakdb task-status" [] {
        [pending running succeeded failed cancelled]
    }
    export def "nu-complete lakdb artifact-experiments" [context: string] { nu-complete lakdb values artifact-experiments $context }
    export def "nu-complete lakdb artifact-batches" [context: string] { nu-complete lakdb values artifact-batches $context }
    export def "nu-complete lakdb candidate-kinds" [] {
        [experiments ara-experiments artifact-experiments batches artifact-batches papers]
    }
    export def "nu-complete lakdb completion-shells" [] { [nushell] }

